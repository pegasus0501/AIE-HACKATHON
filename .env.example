# Copy to .env and fill in. Never commit .env.

# --- Meta model layer ---
META_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
ENGINEER_MODEL=
TESTER_MODEL=
# low or medium only ("none" is rejected by Meta)
REASONING_EFFORT=low

# --- Stub mode (no network) ---
STUB_LLM=0
# pass | fail_then_pass
STUB_SCENARIO=pass

# --- Agents (stage C: separate processes) ---
ORCHESTRATOR_SEED=
ENGINEER_SEED=
TESTER_SEED=
ORCHESTRATOR_PORT=8000
ENGINEER_PORT=8001
TESTER_PORT=8002
# Printed on startup by each agent
ORCHESTRATOR_ADDRESS=
ENGINEER_ADDRESS=
TESTER_ADDRESS=

# --- Orchestrator ---
MAX_ROUNDS=3
PYTEST_TIMEOUT=60
WORKSPACE_DIR=workspace
EVENTS_FILE=events.jsonl

# --- Experiment rig / pushback ---
# on_pushback: agents get only the vague ticket and the contract is released as answers to their questions
# upfront:     agents get ticket + contract immediately (the rig's documented usage)
CONTRACT_MODE=on_pushback
# Model that answers agents' questions from the contract (defaults to ENGINEER_MODEL)
CLARIFIER_MODEL=
# Seconds without any progress before the Orchestrator gives up on a task
TASK_TIMEOUT=900
